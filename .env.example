# ============================================================
# CodeSentry — Root Environment Configuration
# Copy to .env and fill in real values:  cp .env.example .env
# This is the single source of truth for all services.
# docker-compose reads this via env_file; Node services fall
# back to it automatically when running standalone.
# ============================================================

# ---- Shared / Core ----
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- PostgreSQL ----
POSTGRES_PASSWORD=devpass123
# Use localhost when running services standalone;
# docker-compose overrides this to use the postgres container hostname.
DATABASE_URL=postgresql://dev:devpass123@localhost:5432/codesentry

# ---- JWT (api-service) ----
JWT_SECRET=change-me-64-char-random

# ---- Encryption (api-service) ----
ENCRYPTION_KEY=

# ---- GitHub OAuth (api-service) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ---- GitHub App (api-service + github-service) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=mitig8it

# ---- Webhook Secret (api-service + github-service) ----
# api-service reads this as GITHUB_WEBHOOK_SECRET.
# docker-compose aliases it to WEBHOOK_SECRET for github-service.
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# ---- Internal Service Auth (api-service + github-service) ----
GITHUB_SERVICE_INTERNAL_SECRET=change-me-github-internal-secret

# ---- Service URLs ----
# Use localhost for standalone; docker-compose overrides with container names.
ANALYSIS_SERVICE_URL=http://localhost:8001
GITHUB_SERVICE_URL=http://localhost:3002

# ---- Analysis Queue (api-service, optional) ----
ANALYSIS_QUEUE_CONCURRENCY=1
ANALYSIS_QUEUE_POLL_INTERVAL_MS=5000
ANALYSIS_QUEUE_STALE_MINUTES=20

# ---- Frontend (build-time, Vite) ----
VITE_API_URL=http://localhost:3000

# ---- GitHub Service (optional) ----
WEBHOOK_URL=

# ---- Analysis Service (optional) ----
REDIS_URL=redis://localhost:6379
LLM_TRIAGE_ENABLED=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANALYSIS_CACHE_TTL_DAYS=7
