# Analysis Service — Environment Variables
# All vars come from docker-compose env injection (reads root .env).
# For standalone runs, export vars or source the root .env manually:
#   export $(grep -v '^#' ../../.env | xargs)

PORT=8001
FRONTEND_URL=http://localhost:5173

# Optional — service degrades gracefully if unset
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
LLM_TRIAGE_ENABLED=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TRIAGE_MODEL=gpt-4o-mini
LLM_TRIAGE_TIMEOUT_SECONDS=45
LLM_TRIAGE_MAX_FINDINGS=20
# Tier 3 triage: payload rule and patch critic (false restores the previous behaviour)
LLM_TRIAGE_REQUIRE_PAYLOAD=true
LLM_TRIAGE_CRITIC_ENABLED=true
LLM_TRIAGE_ISOLATE_SEVERITY=high
LLM_TRIAGE_MODEL_HIGH=
LLM_TRIAGE_MAX_CALLS=24
LLM_TRIAGE_MAX_TOKENS=300000
ANALYSIS_CACHE_TTL_DAYS=7
