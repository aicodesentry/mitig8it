{
  "name": "codesentry-api",
  "version": "1.0.0",
  "description": "CodeSentry API service - security review control plane",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint \"src/**/*.js\"",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:integration:access": "NODE_ENV=test node --test tests/integration/access.integration.js",
    "test:integration:lifecycle": "NODE_ENV=test node --test tests/integration/lifecycle.integration.js",
    "test:integration:remediation": "NODE_ENV=test node --test tests/integration/remediation.integration.js",
    "test:integration:transport": "NODE_ENV=test node --test tests/integration/analysis-transport.integration.js",
    "db:migrate": "node src/scripts/runMigrations.js",
    "db:verify": "node src/scripts/verifyMigrations.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "axios": "^1.17.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "google-protobuf": "^4.0.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "prom-client": "^15.1.2"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.2.3"
    }
  }
}
