# The sandbox runner. Its Node has to be the one the service image runs, because the generated
# proofs it executes load TypeScript through Node's type stripper (22.6 and later) and resolve
# their imports through `module.registerHooks` (22.15 and later).
FROM node:22.23.3-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin runner

WORKDIR /runner
COPY src/sandbox/runner.py /runner/runner.py
RUN chmod 0555 /runner/runner.py
USER 65532:65532
ENTRYPOINT ["python3", "/runner/runner.py"]
