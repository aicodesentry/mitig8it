FROM python:3.12.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && addgroup --system --gid 65532 broker \
    && adduser --system --uid 65532 --gid 65532 --no-create-home broker
COPY src ./src
USER 65532:65532
EXPOSE 8003
CMD ["uvicorn", "src.sandbox.broker_app:app", "--host", "0.0.0.0", "--port", "8003", "--no-access-log"]
