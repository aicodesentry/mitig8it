{
  "hosting": [
    {
      "target": "production",
      "public": "frontend/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/auth/callback",
          "destination": "/index.html"
        },
        {
          "source": "/auth{,/**}",
          "run": {
            "serviceId": "codesentry-api",
            "region": "us-central1"
          }
        },
        {
          "source": "/api{,/**}",
          "run": {
            "serviceId": "codesentry-api",
            "region": "us-central1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "codesentry-api",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "staging",
      "public": "frontend/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/auth/callback",
          "destination": "/index.html"
        },
        {
          "source": "/auth{,/**}",
          "run": {
            "serviceId": "codesentry-api-staging",
            "region": "us-central1"
          }
        },
        {
          "source": "/api{,/**}",
          "run": {
            "serviceId": "codesentry-api-staging",
            "region": "us-central1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "codesentry-api-staging",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
