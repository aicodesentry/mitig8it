project_id                              = "replace-with-existing-project-id"
region                                  = "us-central1"
environment                             = "staging"
api_control_plane_service_account_email = "mitig8it-api@replace-with-existing-project-id.iam.gserviceaccount.com"
remediation_dispatch_url                = "https://api-staging.example.com/internal/remediation/tasks"
remediation_dispatch_audience           = "https://api-staging.example.com/internal/remediation/tasks"
remediation_reconciler_url              = "https://api-staging.example.com/internal/remediation/reconcile"
remediation_reconciler_audience         = "https://api-staging.example.com/internal/remediation/reconcile"
artifact_bucket_name                    = "replace-with-globally-unique-remediation-artifacts"
artifact_kms_key_name                   = "projects/replace-with-existing-project-id/locations/us-central1/keyRings/remediation/cryptoKeys/artifacts"

# The Cloud Run Jobs sandbox (docs/runbooks/sandbox-cloud-run-job.md). Default off; enabling it
# creates two buckets, a job identity, an isolated VPC, and the job itself. The image below is
# the placeholder the first apply uses; the runbook's build step replaces it with a real digest.
enable_cloud_run_job_sandbox      = false
sandbox_bucket_prefix             = "replace-with-globally-unique-sandbox-prefix"
sandbox_job_name                  = "codesentry-remediation-sandbox"
sandbox_subnet_cidr               = "10.90.0.0/24"
remediation_service_account_email = "codesentry-remediation@replace-with-existing-project-id.iam.gserviceaccount.com"
